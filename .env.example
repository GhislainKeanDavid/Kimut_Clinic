# Supabase
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Google Calendar (service account — keep this secret, never commit .env)
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_CALENDAR_ID=your_calendar_id@group.calendar.google.com

# n8n (base URL only — paths are appended in code)
N8N_BASE_URL=https://n8n.your-domain.com

# Umami analytics (filled in after Phase 3 — Umami deployment)
PUBLIC_UMAMI_SCRIPT_URL=https://umami.your-domain.com/script.js
PUBLIC_UMAMI_WEBSITE_ID=your-website-uuid-here
PUBLIC_UMAMI_SHARE_URL=https://umami.your-domain.com/share/your-token/your-site-name

# Retell AI — Kim, the voice/chat receptionist
# RETELL_API_KEY is private (server-only). Agent IDs are public (used to identify which agent to talk to).
# Two agents: voice (phone/web call) and chat (text). Endpoints fall back to PUBLIC_RETELL_AGENT_ID if either is unset.
RETELL_API_KEY=your_retell_api_key_here
PUBLIC_RETELL_VOICE_AGENT_ID=agent_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
PUBLIC_RETELL_CHAT_AGENT_ID=agent_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
PUBLIC_KIM_PHONE_NUMBER=+639XXXXXXXXX
